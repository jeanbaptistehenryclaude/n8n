    def analyze_request(self, request: str) -> Dict[str, Any]:
        """Analyse une demande utilisateur et détermine la méthodologie"""
        request_lower = request.lower()
        
        # Détection du type de tâche
        task_type = None
        if any(word in request_lower for word in ["rapport", "étude", "note de calcul"]):
            task_type = "generation_document"
        elif any(word in request_lower for word in ["cctp", "cahier des charges"]):
            task_type = "generation_cctp"
        elif any(word in request_lower for word in ["devis", "métré", "quantités"]):
            task_type = "generation_devis"
        elif any(word in request_lower for word in ["analyse", "données", "contrôle"]):
            task_type = "analyse_donnees"
        elif any(word in request_lower for word in ["checklist", "vérification"]):
            task_type = "generation_checklist"
        elif any(word in request_lower for word in ["planning", "planification"]):
            task_type = "optimisation_planning"
        elif any(word in request_lower for word in ["conformité", "norme"]):
            task_type = "verification_conformite"
        
        return {
            "task_type": task_type,
            "complexity": "medium",  # À affiner avec l'analyse du contenu
            "estimated_time": "5-15 minutes",
            "required_data": self._identify_required_data(request),
            "methodology": self._generate_methodology(task_type)
        }

    def _identify_required_data(self, request: str) -> List[str]:
        """Identifie les données nécessaires pour traiter la demande"""
        required_data = []
        request_lower = request.lower()
        
        if "métré" in request_lower or "quantités" in request_lower:
            required_data.extend(["plans", "cotes", "spécifications techniques"])
        if "contrôle" in request_lower or "essais" in request_lower:
            required_data.extend(["résultats d'essais", "seuils réglementaires"])
        if "planning" in request_lower:
            required_data.extend(["fichier MS Project/Excel", "ressources disponibles"])
        if "conformité" in request_lower:
            required_data.extend(["référentiel normatif", "documents à vérifier"])
            
        return required_data

